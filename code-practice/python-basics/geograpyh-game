import random #拿一个随机抽奖器
question=[
    ["中国的首都是哪里","上海","北京","广州",2],
    ["以下哪个是中国的邻国？","日本","俄罗斯","印度",2],
    ["长江是中国最长的河流","它最终流入哪个海","渤海","东海","南海",2],
    ["世界上最高的山峰是什么？","乔戈里峰","珠穆朗玛峰","千城章嘉峰",2],
    ["以下哪个国家不属于亚洲？","中国","埃及","印度",2],
]  #定义5个问题，采用二维列表，一个二维列表里面有题目，3个选项，正确选项是2（一般默认最后就是正确答案），除了二维列表，还有字典列表，结构更清晰，二维列表：更简洁，数据量小的时候够用；字典列表：更清晰、更易维护，推荐用于稍复杂的项目。
def ask_question():#这行是定义“自动出题机的名字”，def本身就是定义函数；心得：每个函数、变量名缩进的代码都是属于这个函数、变量名整体。
    q=random.choice(question)#"."表示random里面的，"()"表示要执行/调用，从上面的question中选择一道题定义为q
    print("\n"+q[0])#\n表示换行，print()里面什么时候加"",变量不需要，数字不需要，只有字符串才需要（但是要区分字符串变量和字符串）
    print("1."+q[1])#q[1]表示这个列表中的第1项
    print("2."+q[2])
    print("3."+q[3])
    answer=input("请选择(输入1/2/3):")#input（)里面必须要有引号
    answer=int(answer)#int把输入的文字1、2、3转换成为数字
    if answer==q[4]:#两个等号是比较，一个等号是赋值
        print("回答正确！")
        return True#这行的意义在于让程序知道答对了，没有的话下面else就执行不了，程序不知道有没有情况
    else:
        print("回答错误，正确答案是:"+str(q[4]))
        return False
print("="*40)#为什么这里要顶行写？主要是这里开始跟上面def ask+question没有关系了（顶行写 = 代码在"全局作用域"，缩进写 = 代码在"某个代码块内部"（比如函数里）
print("  地理探险家")
print("="*40)#*表示乘法运算符
print("欢迎来到地理知识问答！")
print("一共有5道题,答对越多越厉害！")
print()#表示空一行
score=0  #如何区分是创建的变量还是函数，比如question=/def ask_question/score=.变量存数据，函数存动作
total=len(question) #len()表示数长度
for i in range(total):#for i in range(),这个循环语句，表示循环，range()是 Python 内置的"数字生成器"函数，用来生成一个整数序列。3种用法，一个参数，range(n),[0,1,2,3,4,n-1];range(2,6),[2,3,4,5];range(0,10,2),[0,2,4,6,8];range(5,0,-1),[5,4,3,2,1]
    print(f"\n---第{i+1}题---")#f表示f-string(格式化字符串)，（）调用函数，例如print()/range()/int()/input()数学运算，例如result=(3=5)*定义元组color=("红","绿","蓝"）。[]取元素，如q=["中国的首都是哪里“，"上海","北京","广州"],print(q[0]).定义列表、切片，如number[0,1,2,3],print(number[1:4],取1-4,print(nmuber[:3],取前3个。{}定义字典、f-string插变量
    if ask_question():#此处对答题进行确认，即如果返回了正确
        score=score+1
print("\n"+"="*40)
print("    游戏结束！")
print("="*40)
print(f"你答对了{score}题,共{total}题")
if score ==total:
    print("完美！你是地理大师！")
elif score >=total-1:
    print("优秀！你离大师只差一步！")
elif score >=total/2:
    print("不错！继续加油！")
else:
    print("再接再厉，多看看世界地图吧！")
print("\n谢谢游玩！")#\n代表换行，为什么写代码已经换行了？还要\n呢？代码里换行写，只是代码排版，不代表程序运行时屏幕会换行